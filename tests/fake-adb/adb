#!/bin/bash
# Fake adb: simulates an NL5H00X-class Android projector well enough to run
# the toolkit scripts end to end without hardware.
#
# The "device" is a directory tree under $FAKE_ADB_STATE:
#   blockdev      - a real file standing in for /dev/block/mmcblk0
#   sdcard/       - stands in for /sdcard
#
# Behaviour knobs (env):
#   FAKE_ADB_STATE        state dir (required)
#   FAKE_ADB_SU_MODE      direct | piped | none   (default: direct)
#   FAKE_ADB_PROPAGATE_RC 1 = adb exits with the remote status,
#                         0 = adb always exits 0 (old shell protocol; default)
#   FAKE_ADB_TRUNCATE_AT  byte count to truncate every dd output to, simulating
#                         a short write that dd does not report
#   FAKE_ADB_FREE_KB      free space on /sdcard in KB (default: tiny, forces
#                         the chunked path)

set -uo pipefail

STATE="${FAKE_ADB_STATE:?FAKE_ADB_STATE not set}"
# piped, not direct: the real NL5H00X rejects `su -c` with
# "su: invalid uid/gid '-c'" and only accepts `echo cmd | su` (measured
# 2026-07-28). The emulator's default has to match the hardware, or every
# script gets developed against a device that does not exist.
SU_MODE="${FAKE_ADB_SU_MODE:-piped}"
PROPAGATE_RC="${FAKE_ADB_PROPAGATE_RC:-0}"
FREE_KB="${FAKE_ADB_FREE_KB:-1024}"

mkdir -p "$STATE/sdcard"

# adb's own exit status. Real adb on older devices returns 0 regardless of what
# happened on the far side; that is the default here because it is the case the
# toolkit has to survive.
finish() {
    local remote_rc="$1"
    [[ "$PROPAGATE_RC" == "1" ]] && exit "$remote_rc"
    exit 0
}

# ---------------------------------------------------------------------------
# Remote command dispatch
# ---------------------------------------------------------------------------
# Filesystem operations against the modelled device tree.
#
# The refusal is the point: /system starts read-only, and a write to it fails
# exactly as it does on the device. An unlock that forgets to remount has to
# fail here too, or the emulator is just agreeing with whatever the script does.
fs_op() {
    local cmd="$1"
    set -- $cmd
    local op="$1"; shift
    [[ "$op" == "rm" ]] && shift            # -rf
    [[ "$op" == "mkdir" && "$1" == "-p" ]] && shift

    local target="${!#}"                     # last argument
    if [[ "$target" == /system/* && "$(sget mount_system ro)" == "ro" ]]; then
        echo "$op: '$target': Read-only file system" >&2
        return 1
    fi

    case "$op" in
        mkdir) mkdir -p "${STATE}${target}" ;;
        chmod|chown) [[ -e "${STATE}${target}" ]] || { echo "$op: '$target': No such file or directory" >&2; return 1; } ;;
        rm) rm -rf "${STATE}${target}" ;;
        cp)
            local src="$1"
            [[ -e "${STATE}${src}" ]] || { echo "cp: '$src': No such file or directory" >&2; return 1; }
            mkdir -p "$(dirname "${STATE}${target}")"
            cp -R "${STATE}${src}" "${STATE}${target}"
            ;;
    esac
    return 0
}

# --- mutable device state -------------------------------------------------
# Files under $STATE; absent files mean "this profile does not model it", so
# the backup-only seeds keep working without carrying unlock state around.
sget() { [[ -f "$STATE/$1" ]] && cat "$STATE/$1" || echo "$2"; }
setting_get() {
    [[ -f "$STATE/settings" ]] || { echo null; return; }
    local v
    v=$(awk -v n="$1" -v k="$2" '$1==n && $2==k {print $3}' "$STATE/settings")
    echo "${v:-null}"
}
setting_put() {
    touch "$STATE/settings"
    grep -v "^$1 $2 " "$STATE/settings" > "$STATE/settings.new" 2>/dev/null || true
    echo "$1 $2 $3" >> "$STATE/settings.new"
    mv "$STATE/settings.new" "$STATE/settings"
}
pkg_enabled() { ! grep -qx "$1" "$STATE/packages_disabled" 2>/dev/null; }
pkg_known()   { grep -q "=$1\$" "$STATE/packages" 2>/dev/null; }

# Which packages currently have a process. `am start` adds one, a reboot clears
# them all. This is what lets the emulator distinguish "installed" from
# "actually runs", which is the distinction the unlock's safety gate rests on.
proc_running() { grep -qx "$1" "$STATE/running" 2>/dev/null; }
proc_start()   { proc_running "$1" || echo "$1" >> "$STATE/running"; }

# Identity of an APK being installed. Real pm reads the manifest; there is no
# manifest parser here, so a test can drop a "<apk>.meta" sidecar with pkg= and
# home= lines. Without one, both are looked up below.
#
# The activity strings are the ones actually declared in the shipped APKs --
# read out of their manifests with apkanalyzer, see apks/PROVENANCE.md. Nothing
# in the toolkit depends on them being right, because it resolves the component
# off the device with query-activities, but an invented string sitting in the
# repo is a lie waiting to be believed.
apk_meta() {
    local apk="$1" key="$2"
    if [[ -f "$apk.meta" ]]; then
        sed -n "s/^$key=//p" "$apk.meta" | head -1
        return
    fi
    local base pkg home
    base=$(basename "$apk")
    case "$base" in
        *projectivy*|*projengmenu*)
            pkg="com.spocky.projengmenu"
            home="$pkg/com.spocky.projengmenu.ui.home.MainActivity" ;;
        *nova*|*teslacoilsw*)
            pkg="com.teslacoilsw.launcher"
            home="$pkg/com.teslacoilsw.launcher.NovaLauncher" ;;
        *)  return ;;
    esac
    case "$key" in
        pkg)  echo "$pkg" ;;
        home) echo "$home" ;;
    esac
}

run_remote() {
    local cmd="$1"

    case "$cmd" in
        whoami)
            echo root
            return 0
            ;;

        # --- properties -------------------------------------------------
        "getprop "*)
            local k="${cmd#getprop }"
            [[ -f "$STATE/props" ]] && awk -F= -v k="$k" '$1==k{print $2}' "$STATE/props"
            return 0 ;;
        getprop)
            if [[ -f "$STATE/props" ]]; then
                awk -F= '{printf "[%s]: [%s]\n",$1,$2}' "$STATE/props"
            else
                echo "[ro.product.model]: [NL5H00X]"
                echo "[ro.build.version.sdk]: [28]"
            fi
            return 0 ;;

        # --- settings ---------------------------------------------------
        "settings put "*)
            set -- $cmd; setting_put "$3" "$4" "$5"; return 0 ;;
        "settings get "*)
            set -- $cmd; setting_get "$3" "$4"; return 0 ;;

        # --- mount ------------------------------------------------------
        # System-as-root, like the real device: /system is a directory on /,
        # not a mount of its own, so it never appears in /proc/mounts and the
        # remount has to target /. A toolkit that remounts /system gets the
        # device's actual answer here instead of a helpful fiction.
        "mount -o remount,rw /"|"mount -o rw,remount /")
            echo rw > "$STATE/mount_system"; return 0 ;;
        "mount -o remount,ro /"|"mount -o ro,remount /")
            echo ro > "$STATE/mount_system"; return 0 ;;
        "mount -o remount,rw /system"|"mount -o rw,remount /system"|\
        "mount -o remount,ro /system"|"mount -o ro,remount /system")
            echo "mount: '/system' not in /proc/mounts" >&2; return 1 ;;
        "cat /proc/mounts")
            echo "/dev/root / ext4 $(sget mount_system ro),seclabel,relatime 0 0"
            echo "/dev/block/platform/soc/f9830000.emmc/by-name/userdata /data ext4 rw,seclabel,nosuid 0 0"
            return 0 ;;
        "mount")
            echo "/dev/root / ext4 $(sget mount_system ro),seclabel 0 0"; return 0 ;;

        # --- SELinux ----------------------------------------------------
        "setenforce 0") echo Permissive > "$STATE/selinux"; return 0 ;;
        "setenforce 1") echo Enforcing  > "$STATE/selinux"; return 0 ;;
        getenforce)     sget selinux Enforcing; return 0 ;;

        # --- packages ---------------------------------------------------
        "pm list packages -f"*)
            if [[ -f "$STATE/packages" ]]; then sed 's/^/package:/' "$STATE/packages"
            else echo "package:/system/app/RGTPLauncher/RGTPLauncher.apk=com.newlink.hisilauncher"; fi
            return 0 ;;
        "pm list packages -d"*)
            [[ -f "$STATE/packages_disabled" ]] && sed 's/^/package:/' "$STATE/packages_disabled"; return 0 ;;
        "pm list packages -e"*|"pm list packages")
            if [[ -f "$STATE/packages" ]]; then
                cut -d= -f2 "$STATE/packages" | while read -r p; do
                    pkg_enabled "$p" && echo "package:$p"
                done
            else
                echo "package:com.newlink.hisilauncher"
            fi
            return 0 ;;
        "pm disable-user "*|"pm disable "*)
            local p="${cmd##* }"
            # Models a device that will not let its launcher be disabled. The
            # unlock must not leave the user with no home screen when this
            # happens -- it has to back its own change out.
            if [[ "${FAKE_ADB_REFUSE_DISABLE:-0}" == "1" ]]; then
                echo "Error: java.lang.SecurityException: Cannot disable $p" >&2
                return 1
            fi
            grep -q "=$p$" "$STATE/packages" 2>/dev/null || {
                echo "Error: package $p not found" >&2; return 1; }
            grep -qx "$p" "$STATE/packages_disabled" 2>/dev/null || echo "$p" >> "$STATE/packages_disabled"
            echo "Package $p new state: disabled-user"; return 0 ;;
        "pm enable "*)
            local p="${cmd##* }"
            grep -vx "$p" "$STATE/packages_disabled" > "$STATE/pd.new" 2>/dev/null || true
            mv "$STATE/pd.new" "$STATE/packages_disabled" 2>/dev/null || true
            echo "Package $p new state: enabled"; return 0 ;;
        "pm install"*)
            local apk="${cmd##* }"
            if [[ "$(setting_get secure install_non_market_apps)" == "0" ]]; then
                echo "Failure [INSTALL_FAILED_VERIFICATION_FAILURE]"; return 1
            fi
            [[ -f "${STATE}${apk}" ]] || { echo "Failure [INSTALL_FAILED_INVALID_URI]"; return 1; }
            echo Success; return 0 ;;
        "pm uninstall "*)
            local p="${cmd##* }"
            pkg_known "$p" || { echo "Failure [DELETE_FAILED_INTERNAL_ERROR]"; return 1; }
            grep -v "=$p\$" "$STATE/packages" > "$STATE/pkg.new" 2>/dev/null || true
            mv "$STATE/pkg.new" "$STATE/packages"
            grep -v "^$p/" "$STATE/home_activities" > "$STATE/ha.new" 2>/dev/null || true
            mv "$STATE/ha.new" "$STATE/home_activities" 2>/dev/null || true
            grep -vx "$p" "$STATE/running" > "$STATE/run.new" 2>/dev/null || true
            mv "$STATE/run.new" "$STATE/running" 2>/dev/null || true
            echo Success; return 0 ;;

        # --- processes ---------------------------------------------------
        "am start -n "*)
            [[ -f "$STATE/packages" ]] || return 0     # profile does not model packages
            local comp="${cmd##* }" p
            p="${comp%%/*}"
            pkg_known "$p" || { echo "Error: Activity class {$comp} does not exist."; return 0; }
            pkg_enabled "$p" || { echo "Error: Activity not started, package $p is currently frozen."; return 0; }
            echo "Starting: Intent { cmp=$comp }"
            # A launcher that starts and immediately dies is the case the unlock
            # has to refuse to build on, so it is reachable from a knob.
            if [[ "${FAKE_ADB_LAUNCHER_CRASHES:-0}" == "1" && "$p" == "${FAKE_ADB_LAUNCHER_PKG:-com.spocky.projengmenu}" ]]; then
                return 0
            fi
            proc_start "$p"; return 0 ;;
        "pidof "*)
            local p="${cmd##* }"
            proc_running "$p" || return 1
            echo 4242; return 0 ;;

        # --- home activity ----------------------------------------------
        "cmd package query-activities"*)
            # --brief style output: one component per line.
            [[ -f "$STATE/home_activities" ]] || { echo "com.newlink.hisilauncher/.MainActivity"; return 0; }
            local c p2
            while read -r c; do
                [[ -z "$c" ]] && continue
                p2="${c%%/*}"
                pkg_enabled "$p2" && echo "$c"
            done < "$STATE/home_activities"
            return 0 ;;
        "cmd package set-home-activity "*)
            local comp="${cmd##* }"
            local pkg="${comp%%/*}"
            grep -q "=$pkg$" "$STATE/packages" 2>/dev/null || {
                echo "Error: component $comp not found" >&2; return 1; }
            pkg_enabled "$pkg" || { echo "Error: package $pkg is disabled" >&2; return 1; }
            echo "$comp" > "$STATE/home_activity"
            echo Success; return 0 ;;
        # API 28 HAS NO get-home-activity. Measured on the device 2026-07-29:
        # it answers exactly this, and set-home-activity works fine. The
        # emulator used to answer the question helpfully, so code that read a
        # command the hardware does not have looked correct here and printed
        # "Unknowncommand:get-home-activity" as the home screen on the device.
        "cmd package get-home-activity"*)
            echo "Unknown command: get-home-activity"; return 0 ;;
        "dumpsys package preferred-activities"*)
            # The shape the real dumpsys emits, which is where the preferred
            # home actually has to be read from on this API level.
            local ha; ha=$(sget home_activity "com.newlink.hisilauncher/.WizardAciticity")
            echo "Preferred Activities User 0:"
            echo "  Non-Data Actions:"
            echo "      android.intent.action.MAIN:"
            echo "        bb697d9 $ha"
            echo "         mMatch=0x100000 mAlways=true"
            echo "          Action: \"android.intent.action.MAIN\""
            echo "          Category: \"android.intent.category.HOME\""
            echo "          Category: \"android.intent.category.DEFAULT\""
            return 0 ;;

        # --- existence checks --------------------------------------------
        "ls -d "*)
            local path="${cmd#ls -d }"
            if [[ -e "${STATE}${path}" ]]; then echo "$path"; return 0; fi
            echo "ls: $path: No such file or directory" >&2; return 1 ;;
        "test -e "*|"test -d "*|"test -f "*)
            local path="${cmd##* }"
            [[ -e "${STATE}${path}" ]] && return 0 || return 1 ;;

        # --- filesystem under /system ------------------------------------
        "cp "*|"mkdir "*|"chmod "*|"chown "*|"rm -rf "*)
            fs_op "$cmd"; return $? ;;
        esac

    case "$cmd" in
        "blockdev --getsize64 "*)
            stat -f%z "$STATE/blockdev" 2>/dev/null || stat -c%s "$STATE/blockdev"
            return 0
            ;;
        "cat /proc/partitions")
            local sz
            sz=$(stat -f%z "$STATE/blockdev" 2>/dev/null || stat -c%s "$STATE/blockdev")
            echo "major minor  #blocks  name"
            echo " 179        0  $((sz / 1024)) mmcblk0"
            return 0
            ;;
        getprop)
            echo "[ro.product.model]: [NL5H00X]"
            echo "[ro.build.version.sdk]: [28]"
            return 0
            ;;
        "pm list packages"*)
            echo "package:com.newlink.hisilauncher"
            return 0
            ;;
        "cmd package get-home-activity"*)
            echo "Unknown command: get-home-activity"
            return 0
            ;;
        "dumpsys package preferred-activities"*)
            echo "Preferred Activities User 0:"
            echo "  Non-Data Actions:"
            echo "      android.intent.action.MAIN:"
            echo "        bb697d9 com.newlink.hisilauncher/.WizardAciticity"
            echo "         mMatch=0x100000 mAlways=true"
            echo "          Category: \"android.intent.category.HOME\""
            return 0
            ;;
        "df /sdcard/"*|"df /sdcard")
            echo "Filesystem  1K-blocks  Used Available Use% Mounted on"
            echo "/dev/fuse     8000000  1000  $FREE_KB   1% /sdcard"
            return 0
            ;;
        "ls -l "*)
            local path="${cmd#ls -l }"
            local local_path="${STATE}${path}"
            if [[ ! -f "$local_path" ]]; then
                echo "ls: $path: No such file or directory" >&2
                return 1
            fi
            local sz
            sz=$(stat -f%z "$local_path" 2>/dev/null || stat -c%s "$local_path")
            echo "-rw-rw---- 1 root sdcard_rw $sz 2026-07-27 03:00 $(basename "$path")"
            return 0
            ;;
        "rm -f "*)
            local path="${cmd#rm -f }"
            rm -f "${STATE}${path}"
            return 0
            ;;
        "dd "*)
            run_dd "$cmd"
            return $?
            ;;
        "am start"*|"cmd package set-home-activity"*)
            return 0
            ;;
        *)
            echo "fake-adb: unhandled remote command: $cmd" >&2
            return 127
            ;;
    esac
}

# Real dd reports a transfer summary on stderr, and this device's su merges the
# child's stderr into stdout -- so an unsuppressed dd appends ~95 bytes of
# "N+0 records in" straight into a streamed image. Reproduced here so the
# toolkit's defence against it is actually exercised.
dd_summary() {
    local cmd="$1" src="$2" bs="$3" skip="$4" count="$5"
    # FAKE_ADB_FORCE_DD_SUMMARY models a device whose su merges the summary in
    # despite the redirect, so the toolkit's size assertion is the last defence.
    if [[ "${FAKE_ADB_FORCE_DD_SUMMARY:-0}" != "1" ]]; then
        [[ "$cmd" == *"2>/dev/null"* ]] && return 0
    fi

    local total blocks
    total=$(stat -f%z "$src" 2>/dev/null || stat -c%s "$src")
    if [[ -n "$count" ]]; then
        blocks="$count"
    else
        blocks=$(( (total - skip * bs + bs - 1) / bs ))
    fi
    {
        echo "${blocks}+0 records in"
        echo "${blocks}+0 records out"
        echo "$(( blocks * bs )) bytes transferred in 0.051 secs (20560313 bytes/sec)"
    } >&2
}

# Emulate dd against the stand-in block device.
run_dd() {
    local cmd="$1"
    local if_="" of_="" bs=512 skip=0 count=""
    local tok
    for tok in $cmd; do
        case "$tok" in
            if=*)    if_="${tok#if=}" ;;
            of=*)    of_="${tok#of=}" ;;
            bs=*)    bs="${tok#bs=}" ;;
            skip=*)  skip="${tok#skip=}" ;;
            count=*) count="${tok#count=}" ;;
        esac
    done

    # Map device paths onto the state dir.
    local src dst
    case "$if_" in
        /dev/block/mmcblk0) src="$STATE/blockdev" ;;
        /dev/block/*)       src="$STATE/blockdev" ;;  # partitions: same backing file
        *)                  src="${STATE}${if_}" ;;
    esac

    if [[ ! -f "$src" ]]; then
        echo "dd: $if_: No such file or directory" >&2
        return 1
    fi

    local args=(if="$src" bs="$bs")
    [[ "$skip" != "0" ]] && args+=(skip="$skip")
    [[ -n "$count" ]] && args+=(count="$count")

    # No of= means stream to stdout -- the exec-out path.
    if [[ -z "$of_" ]]; then
        # Models the observed hardware failure: the remote dd is reaped partway
        # and the stream just stops, with no error anywhere.
        if [[ "${FAKE_ADB_SHORT_STREAM_ONCE:-0}" == "1" && ! -f "$STATE/.short_used" ]]; then
            touch "$STATE/.short_used"
            dd "${args[@]}" 2>/dev/null | dd bs=1024 count=1 2>/dev/null
            return 0
        fi
        # The failure that actually happens: the remote dd is reaped, the stream
        # stops, and exec-out never returns. Returning short is the easy case;
        # hanging is the one that defeats a naive retry loop.
        if [[ "${FAKE_ADB_HANG_STREAM_ONCE:-0}" == "1" && ! -f "$STATE/.hang_used" ]]; then
            touch "$STATE/.hang_used"
            dd "${args[@]}" 2>/dev/null | dd bs=1024 count=1 2>/dev/null
            sleep 600
            return 0
        fi
        # FAKE_ADB_MBPS throttles the stream to a given MB/s. Local disk copies
        # a block instantly, which is fine for correctness but useless for
        # exercising anything that watches progress over time -- a UI, a stall
        # detector, an ETA. Those need a transfer that actually takes a while.
        if [[ -n "${FAKE_ADB_MBPS:-}" ]]; then
            # Build the args fresh -- reusing "${args[@]}" here appended a second
            # skip=/count= to ones already present and dd read nothing.
            local total want n=0
            total=$(stat -f%z "$src" 2>/dev/null || stat -c%s "$src")
            if [[ -n "$count" ]]; then
                want="$count"
            else
                want=$(( (total - skip * bs + bs - 1) / bs ))
            fi
            while [[ "$n" -lt "$want" ]]; do
                dd if="$src" bs="$bs" skip=$(( skip + n )) count=1 2>/dev/null || break
                n=$((n + 1))
                perl -e "select(undef,undef,undef,$bs/1048576/$FAKE_ADB_MBPS)" 2>/dev/null || true
            done
            return 0
        fi
        dd "${args[@]}" 2>/dev/null
        dd_summary "$cmd" "$src" "$bs" "$skip" "$count"
        return 0
    fi

    dst="${STATE}${of_}"
    if ! dd "${args[@]}" of="$dst" 2>/dev/null; then
        echo "dd: write error" >&2
        return 1
    fi
    dd_summary "$cmd" "$src" "$bs" "$skip" "$count"

    # Simulated short write: the data is truncated but dd still reports success.
    # This is the failure the toolkit must catch on its own.
    # FAKE_ADB_TRUNCATE_MIN_SKIP delays the fault to a later chunk, so earlier
    # chunks land intact and the run has partial evidence to preserve.
    if [[ -n "${FAKE_ADB_TRUNCATE_AT:-}" && -f "$dst" ]] \
       && [[ "$skip" -ge "${FAKE_ADB_TRUNCATE_MIN_SKIP:-0}" ]]; then
        local cur
        cur=$(stat -f%z "$dst" 2>/dev/null || stat -c%s "$dst")
        if [[ "$cur" -gt "$FAKE_ADB_TRUNCATE_AT" ]]; then
            local tmp="$dst.trunc"
            dd if="$dst" of="$tmp" bs=1 count="$FAKE_ADB_TRUNCATE_AT" 2>/dev/null
            mv "$tmp" "$dst"
        fi
    fi

    return 0
}

# ---------------------------------------------------------------------------
# Unwrap the su forms the toolkit uses
# ---------------------------------------------------------------------------
unwrap_su() {
    local shell_cmd="$1"

    # su -c 'CMD'
    if [[ "$shell_cmd" == "su -c '"* ]]; then
        [[ "$SU_MODE" == "direct" ]] || return 1
        local inner="${shell_cmd#su -c \'}"
        printf '%s' "${inner%\'*}"
        return 0
    fi

    # echo 'CMD' | su   (also: { echo 'CMD'; } | su)
    if [[ "$shell_cmd" == *"| su"* && "$shell_cmd" == "echo '"* ]]; then
        [[ "$SU_MODE" == "piped" ]] || return 1
        local inner="${shell_cmd#echo \'}"
        printf '%s' "${inner%%\'*}"
        return 0
    fi

    return 2  # not an su wrapper
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
[[ $# -eq 0 ]] && { echo "fake-adb: no args" >&2; exit 1; }

subcmd="$1"; shift

case "$subcmd" in
    devices)
        echo "List of devices attached"
        [[ "${FAKE_ADB_NO_DEVICE:-0}" == "1" ]] || echo "FAKE0123456	device"
        exit 0
        ;;

    pull)
        remote="$1"; local_dst="${2:-.}"
        if [[ ! -f "${STATE}${remote}" ]]; then
            echo "adb: error: remote object '$remote' does not exist" >&2
            exit 1
        fi
        cp "${STATE}${remote}" "$local_dst"
        exit 0
        ;;

    push)
        cp "$1" "${STATE}${2}"
        exit 0
        ;;

    install)
        apk=""
        while [[ $# -gt 0 ]]; do apk="$1"; shift; done   # last arg is the APK
        [[ -f "$apk" ]] || { echo "adb: failed to stat $apk: No such file or directory" >&2; exit 1; }
        pkg=$(apk_meta "$apk" pkg)
        if [[ -z "$pkg" ]]; then
            echo "Failure [INSTALL_PARSE_FAILED_NO_CERTIFICATES]"; exit 1
        fi
        # The real NL5H00X refuses every install this way -- measured 2026-07-29
        # with sideloading on, no restrictions, install location auto and 4.2 GB
        # free. /data/app is empty and `pm list packages -3` is empty, so nothing
        # has ever been installed normally on it. The toolkit has to fall back to
        # /system/app, and that fallback only counts as tested if the emulator
        # can refuse the same way.
        if [[ "${FAKE_ADB_REFUSE_INSTALL:-0}" == "1" ]]; then
            echo "Failure [INSTALL_FAILED_INVALID_INSTALL_LOCATION]"; exit 1
        fi
        # The device refuses sideloads until the unlock has allowed them, which
        # is what makes dev_options a real prerequisite rather than a courtesy.
        if [[ "$(setting_get secure install_non_market_apps)" == "0" ]]; then
            echo "Failure [INSTALL_FAILED_VERIFICATION_FAILURE]"; exit 1
        fi
        if ! pkg_known "$pkg"; then
            echo "/data/app/$pkg-1/base.apk=$pkg" >> "$STATE/packages"
            apk_meta "$apk" home >> "$STATE/home_activities"
        fi
        echo Success
        exit 0
        ;;

    backup)
        out=""
        while [[ $# -gt 0 ]]; do
            [[ "$1" == "-f" ]] && { out="$2"; shift; }
            shift
        done
        [[ -n "$out" ]] && printf 'ANDROID BACKUP\n5\n0\nnone\n' > "$out"
        exit 0
        ;;

    reboot)
        # MODELLED HYPOTHESIS, not a measured fact. Evidence: Nova Launcher has
        # been sitting in /system/app since 2025-07-15 and the device still
        # boots com.newlink.hisilauncher, so something re-asserts the stock
        # launcher. The simplest model that explains it is that it wins on boot
        # while it is still enabled. If the real mechanism turns out to differ,
        # this is the line to change -- and the unlock's "disable the stock
        # launcher" step is what makes it robust either way.
        if [[ -f "$STATE/home_activity" ]] && pkg_enabled com.newlink.hisilauncher; then
            echo "com.newlink.hisilauncher/.WizardAciticity" > "$STATE/home_activity"
        fi
        [[ -f "$STATE/reboots" ]] && echo $(( $(cat "$STATE/reboots") + 1 )) > "$STATE/reboots"
        # Nothing survives a restart except what the system brings back up: the
        # home package. Without this, a launcher proven alive before a reboot
        # would still look alive after one, and the gate would never be tested.
        : > "$STATE/running" 2>/dev/null || true
        if [[ -f "$STATE/home_activity" ]]; then
            home_pkg=$(cut -d/ -f1 "$STATE/home_activity")
            [[ -n "$home_pkg" ]] && echo "$home_pkg" >> "$STATE/running"
        fi
        echo ro > "$STATE/mount_system" 2>/dev/null || true
        exit 0
        ;;

    exec-out)
        # Older adb / device builds have no exec-out; the toolkit must fall
        # back to a staged backup rather than produce nothing.
        if [[ "${FAKE_ADB_NO_EXEC_OUT:-0}" == "1" ]]; then
            echo "adb: unknown command exec-out" >&2
            exit 1
        fi
        # Raw binary channel. The device's su merges the child's stderr into
        # stdout, so this does too -- that merge is the contamination hazard.
        shell_cmd="$*"
        inner=$(unwrap_su "$shell_cmd")
        case $? in
            0) : ;;
            1) echo "su: invalid option -- c" >&2; finish 1 ;;
            *) inner="$shell_cmd" ;;
        esac
        run_remote "$inner" 2>&1
        finish $?
        ;;

    shell)
        shell_cmd="$*"

        # Strip the exit-status sentinel the toolkit appends, if present.
        sentinel=0
        if [[ "$shell_cmd" == *'; echo __RC__=$?' ]]; then
            sentinel=1
            shell_cmd="${shell_cmd%'; echo __RC__=$?'}"
        fi
        # 2>&1 inside the remote command is for the device's shell, not ours.
        shell_cmd="${shell_cmd% 2>&1}"

        inner=$(unwrap_su "$shell_cmd")
        case $? in
            0) : ;;                       # unwrapped an su form we support
            1)                            # su form the "device" does not support
                echo "su: invalid option -- c" >&2
                [[ "$sentinel" == "1" ]] && echo '__RC__=1'
                finish 1
                ;;
            *) inner="$shell_cmd" ;;      # plain, non-root command
        esac

        run_remote "$inner"
        rc=$?
        [[ "$sentinel" == "1" ]] && echo "__RC__=$rc"
        finish "$rc"
        ;;

    *)
        echo "fake-adb: unhandled subcommand: $subcmd" >&2
        exit 1
        ;;
esac
