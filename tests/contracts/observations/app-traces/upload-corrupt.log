adb	devices
adb	shell	su\ -c\ \'whoami\'
adb	shell	su\ -c\ \'dumpsys\ package\ com.example.utf16\'\ 2\>\&1\;\ echo\ __RC__=\$\?
adb	install	-r	<SANDBOX>/utf16.apk
adb	push	<SANDBOX>/utf16.apk	/data/local/tmp/utf16.apk
adb	shell	su\ -c\ \'md5sum\ /data/local/tmp/utf16.apk\'\ 2\>\&1\;\ echo\ __RC__=\$\?
adb	shell	su\ -c\ \'rm\ -f\ /data/local/tmp/utf16.apk\'\ 2\>\&1\;\ echo\ __RC__=\$\?
